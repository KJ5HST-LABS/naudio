# naudio — systemd USER unit for na_audio_daemon (issue #96 item 2).
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Generated by CMake from this template: ExecStart follows CMAKE_INSTALL_PREFIX, so the
# unit is truthful for the package that carries it rather than for the machine that
# built it.
#
# A USER unit (`systemctl --user`), deliberately NOT a system unit. PipeWire and
# PulseAudio are per-session services: a system-scope daemon running as root or as a
# service account cannot reach the logged-in user's audio server, so it would install
# cleanly and then fail to capture. This mirrors the macOS agent for the same reason.
#
# Shipped in /usr/lib/systemd/user, which makes the unit AVAILABLE but not enabled —
# installing a package must not start capturing a microphone at the next login. The
# operator enables it once with `systemctl --user enable --now naudio-daemon`; issue #96
# item 4 turns that into a click.
#
# Description= leads with the service's name, the one string every platform shows
# (NAUDIO_APP_NAME, owned in tools/CMakeLists.txt): it is what `systemctl --user status`
# prints beside the unit, as Login Items prints it on a Mac and Task Scheduler's description
# column on Windows. The unit's own name stays naudio-daemon — it is what the documented
# systemctl commands and the daemon's own query name. The servicecheck arm asserts the
# generated unit carries it.

[Unit]
Description=@NAUDIO_APP_NAME@ (naudio audio streaming daemon)
Documentation=man:na_audio_daemon(1)

[Service]
Type=simple
# --duration-ms 0 lives HERE, not in a shipped config file: a service runs until it is
# stopped, always, and a flag cannot be undone by a stray file (flags beat the file —
# issue #96 item 1). Every other setting comes from /etc/naudio/daemon.conf.
#
# --mode control (issue #96 item 4) is a strict superset of what this unit ran before:
# it serves the localhost control page and captures NOTHING until something asks it to,
# so enabling the service gives the operator a page to click rather than a microphone
# that is already open. Capture at login is `autostart = true` in the config file, which
# the page writes from a checkbox — the operator's choice, not the package's.
ExecStart=@NAUDIO_SERVICE_EXEC@ --mode control --duration-ms 0
Restart=on-failure
RestartSec=5
# The daemon's exit-code contract, encoded: 2 is a usage or config-file error — a
# permanent condition a restart cannot fix, so the unit stops and lands in `failed`
# with the file:line refusal in the journal, where `systemctl --user status` shows it.
# 1 (a runtime fault) still restarts. launchd has no equivalent; see the plist.
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
