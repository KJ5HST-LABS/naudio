[Desktop Entry]
# naudio — the desktop entry that opens the control page (issue #96 item 4).
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Generated by CMake so Exec= names the path this build installs to.
#
# The command is the same on all three platforms, and clicking it twice is safe: control mode
# checks whether a naudio control page already answers on the configured port and, if one does,
# opens THAT page and exits 0 instead of failing to bind. So this one entry both starts the
# daemon (when nothing is running) and opens the page (when the logon service already started
# it), with no launcher script to get the two cases wrong.
#
# Icon= is a THEME NAME, not a path (issue #103): the desktop resolves it through
# share/icons/hicolor/<size>x<size>/apps/naudio.png, which the package installs at every
# standard size, and picks the one the menu or panel wants. Until #103 this borrowed the
# theme's audio-card icon.
#
# Name= is the service's name, the one string every platform shows (NAUDIO_APP_NAME, owned in
# tools/CMakeLists.txt): what /Applications holds on a Mac and the Start menu on Windows. The
# servicecheck arm asserts the generated entry carries it. The file's own name stays
# naudio-control.desktop — a path, referenced by the release gate, not a label anyone reads.
Type=Application
Version=1.0
Name=@NAUDIO_APP_NAME@
GenericName=Audio streaming control
Comment=Pick a capture device, save settings and start streaming, in a browser
Exec=@NAUDIO_SERVICE_EXEC@ --mode control --duration-ms 0 --open-page
Icon=naudio
Terminal=false
Categories=AudioVideo;Audio;Network;
Keywords=naudio;audio;streaming;network;
StartupNotify=false
