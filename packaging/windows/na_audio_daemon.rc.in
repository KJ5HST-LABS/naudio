// naudio — the daemon's icon resource (issue #103). SPDX-License-Identifier: LGPL-2.1-or-later
//
// Generated by CMake so the path names this checkout's packaging/icons/naudio.ico; forward
// slashes because rc.exe and windres both accept them and neither treats them as escapes.
// One icon group, id 1: Explorer, the taskbar and a shortcut show an executable's lowest-id
// icon group, and Add/Remove Programs reads the same one through CPACK_NSIS_INSTALLED_ICON_NAME.
1 ICON "@NAUDIO_ICO_PATH@"
