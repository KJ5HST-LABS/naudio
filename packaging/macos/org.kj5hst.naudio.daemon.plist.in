<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  naudio — launchd AGENT for na_audio_daemon (issue #96 item 2).
  SPDX-License-Identifier: LGPL-2.1-or-later

  Generated by CMake from this template: the program path and log destination follow
  CMAKE_INSTALL_PREFIX, so the unit is truthful for the package that carries it rather
  than for the machine that built it.

  An AGENT (per-user, gui/<uid> domain), deliberately NOT a LaunchDaemon (root, system
  domain). A root daemon has no TCC context, so macOS can never grant it microphone
  access — it would install cleanly, start cleanly, and then fail to capture with no
  way for the operator to fix it. The per-user agent is also what makes the config file
  at ~/Library/Application Support/naudio/daemon.conf (issue #96 item 1) the right file
  for this service to read.

  Disabled: true ships the job INERT. Installing a package must not start capturing a
  microphone at the next login. Measured, not assumed: bootstrapping a Disabled:true
  plist fails outright ("Bootstrap failed: 5") and the job never runs, while the same
  plist with Disabled:false runs — and `launchctl enable gui/<uid>/<label>` writes an
  override that beats this key and SURVIVES a bootout/re-bootstrap, so a reinstall or
  upgrade preserves an operator's enabled state instead of silently switching the
  service off. See the man page's SERVICE REGISTRATION section for the enable command;
  issue #96 item 4 turns it into a click.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.kj5hst.naudio.daemon</string>

    <!-- --duration-ms 0 lives HERE, not in a shipped config file: a service runs until
         it is stopped, always, and a flag cannot be undone by a stray file (flags beat
         the file — issue #96 item 1). Every other setting comes from the config file. -->
    <key>ProgramArguments</key>
    <array>
        <string>@NAUDIO_SERVICE_EXEC@</string>
        <string>--duration-ms</string>
        <string>0</string>
    </array>

    <key>Disabled</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on any unsuccessful exit, throttled. launchd cannot discriminate exit
         CODES the way systemd's RestartPreventExitStatus= can, so unlike the systemd
         unit this also retries a permanent config error (exit 2) every 30 s. That is
         why the log destination below is not optional: the file:line refusal is the
         only way an operator sees which line of daemon.conf is wrong. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- launchd does not expand ~ or $HOME, so a per-user log path cannot be expressed
         here; the postinstall creates this directory group-writable by staff (every
         local macOS account is in staff) so the agent can write as the logged-in user.
         systemd needs no equivalent — journald captures the unit's stdout/stderr. -->
    <key>StandardOutPath</key>
    <string>@NAUDIO_SERVICE_LOG@</string>
    <key>StandardErrorPath</key>
    <string>@NAUDIO_SERVICE_LOG@</string>
</dict>
</plist>
