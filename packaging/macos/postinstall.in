#!/bin/sh
# naudio — productbuild postinstall: register the launchd agent (issue #96 item 2).
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Generated by CMake from this template. The payload cannot place this file itself:
# every path in the .pkg is rooted at CPACK_PACKAGING_INSTALL_PREFIX (/usr/local), and
# /Library/LaunchAgents is not under it. So the plist ships in the payload's share/
# tree and this script copies it into place — the ".pkg postinstall" the issue names.
#
# It registers the agent; it does not start it. Nothing runs until the next login, and
# what runs then is the control page with no device open (the agent's own arguments). The
# on/off switch is the platform's — Login Items (issue #102) — which keeps its own state
# across upgrades; the one thing this script does to launchd's state is clear a stale
# `launchctl disable` from the days when the docs named that as the switch (below).
set -eu

# productbuild passes the target VOLUME as $3 ("/" for the boot volume). Honour it, so
# an install onto a non-boot volume writes that volume's LaunchAgents, not this one's.
VOL="${3:-/}"
[ "$VOL" = "/" ] && VOL=""

SRC="${VOL}@NAUDIO_PLIST_PAYLOAD_PATH@"
DST="${VOL}/Library/LaunchAgents/org.kj5hst.naudio.daemon.plist"
LOGDIR="${VOL}@NAUDIO_SERVICE_LOGDIR@"

install -d -m 0755 -o root -g wheel "${VOL}/Library/LaunchAgents"
install -m 0644 -o root -g wheel "$SRC" "$DST"

# The agent runs as the logged-in user, so the directory it logs into must be writable
# by that user: group staff, which every local macOS account belongs to.
install -d -m 0775 -o root -g staff "$LOGDIR"

# Clear a stale `launchctl disable` (issue #102). Through rc8 the plist shipped Disabled:true
# and the docs named `launchctl enable`/`disable` as the service's switch; an operator who ran
# `disable` holds a launchd override that blocks bootstrap while the Login Items switch — the
# switch now — reads on, because the two are independent stores in both directions (measured
# 2026-09-13). Cleared for the console user, whose gui domain is the one this agent is
# bootstrapped into at login. Idempotent, harmless when no override exists, and `|| true`
# because nothing here may fail the install: an install with no console user (uid 0, or a
# remote session) simply has no domain to clear.
console_uid="$(stat -f %u /dev/console 2>/dev/null || echo 0)"
if [ "$console_uid" -ge 500 ] 2>/dev/null; then
    launchctl enable "gui/$console_uid/org.kj5hst.naudio.daemon" || true
fi

# "Network Audio Service.app" into /Applications (issue #96 item 4) — the shortcut that opens
# the control page, named after the service because Login Items shows the agent under this
# bundle's name (issue #102). Same reason as the plist: /Applications is not under the .pkg's
# /usr/local payload prefix, so the payload carries the parts in share/naudio/ and this
# assembles them. The on-disk name below is what the Finder shows — it ignores a
# CFBundleDisplayName that differs from the file name — so it must equal the bundle's
# CFBundleName; the release gate asserts that on the installed files.
#
# ASSEMBLED HERE rather than carried as a bundle. A .app inside the payload is auto-detected by
# pkgbuild, which writes <relocate>/<strict-identifier>/<upgrade-bundle> into PackageInfo and
# lets macOS Installer decide for itself where the bundle goes by looking the identifier up in
# Spotlight. On a CI runner it decided not to place it at all, silently, with the files plainly
# listed in the payload. Two ordinary files and three install(1) calls have no such opinion.
#
# Onto a REMOVED destination, not over a live one: a bundle updated in place can end up holding
# files from two versions at once, and LaunchServices caches what it finds there. The bundle
# rc7 and rc8 installed as "naudio Control.app" goes too: it carries the same identifier, and
# two bundles with one identifier leave LaunchServices — and so Login Items — to pick either.
APP_SRC="${VOL}@NAUDIO_APP_PAYLOAD_DIR@"
APP_DST="${VOL}/Applications/Network Audio Service.app"
APP_LEGACY="${VOL}/Applications/naudio Control.app"
if [ -f "$APP_SRC/naudio-control" ] && [ -f "$APP_SRC/naudio-control.Info.plist" ]; then
    rm -rf "$APP_DST" "$APP_LEGACY"
    install -d -m 0755 -o root -g wheel "$APP_DST/Contents/MacOS"
    install -m 0644 -o root -g wheel "$APP_SRC/naudio-control.Info.plist" \
            "$APP_DST/Contents/Info.plist"
    install -m 0755 -o root -g wheel "$APP_SRC/naudio-control" \
            "$APP_DST/Contents/MacOS/naudio-control"
    # The bundle's Developer ID signature (issue #102), present when the payload was signed:
    # codesign writes it as ordinary files under Contents/_CodeSignature/ — no extended
    # attributes — and a bundle reassembled this way verifies --deep --strict (measured;
    # cmake/CodesignPayload.cmake re-proves it on every signed package). Every file in the
    # directory, not a fixed list: the set codesign writes has varied across macOS releases.
    # An unsigned build ships no such directory and assembles the unsigned bundle as before.
    # (#103's icon is one more `install` beside these, under Contents/Resources.)
    if [ -d "$APP_SRC/naudio-control.codesig" ]; then
        install -d -m 0755 -o root -g wheel "$APP_DST/Contents/_CodeSignature"
        for sig in "$APP_SRC/naudio-control.codesig"/*; do
            [ -f "$sig" ] || continue
            install -m 0644 -o root -g wheel "$sig" "$APP_DST/Contents/_CodeSignature/"
        done
    fi
fi

exit 0
