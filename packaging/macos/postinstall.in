#!/bin/sh
# naudio — productbuild postinstall: register the launchd agent (issue #96 item 2).
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Generated by CMake from this template. The payload cannot place this file itself:
# every path in the .pkg is rooted at CPACK_PACKAGING_INSTALL_PREFIX (/usr/local), and
# /Library/LaunchAgents is not under it. So the plist ships in the payload's share/
# tree and this script copies it into place — the ".pkg postinstall" the issue names.
#
# It registers the agent; it does NOT enable or start it. The plist ships Disabled:true
# and an operator's `launchctl enable` override outlives this copy, so a reinstall or
# upgrade preserves whichever state they chose.
set -eu

# productbuild passes the target VOLUME as $3 ("/" for the boot volume). Honour it, so
# an install onto a non-boot volume writes that volume's LaunchAgents, not this one's.
VOL="${3:-/}"
[ "$VOL" = "/" ] && VOL=""

SRC="${VOL}@NAUDIO_PLIST_PAYLOAD_PATH@"
DST="${VOL}/Library/LaunchAgents/org.kj5hst.naudio.daemon.plist"
LOGDIR="${VOL}@NAUDIO_SERVICE_LOGDIR@"

install -d -m 0755 -o root -g wheel "${VOL}/Library/LaunchAgents"
install -m 0644 -o root -g wheel "$SRC" "$DST"

# The agent runs as the logged-in user, so the directory it logs into must be writable
# by that user: group staff, which every local macOS account belongs to.
install -d -m 0775 -o root -g staff "$LOGDIR"

# "naudio Control.app" into /Applications (issue #96 item 4) — the shortcut that opens the
# control page. Same reason as the plist: /Applications is not under the .pkg's /usr/local
# payload prefix, so the payload carries the bundle in share/naudio/ and this copies it out.
#
# cp -R onto a REMOVED destination, not over a live one: a bundle updated in place can end up
# holding files from both versions, and LaunchServices caches what it finds. Removing first
# makes an upgrade replace rather than merge.
APP_SRC="${VOL}@NAUDIO_APP_PAYLOAD_PATH@"
APP_DST="${VOL}/Applications/naudio Control.app"
if [ -d "$APP_SRC" ]; then
    rm -rf "$APP_DST"
    cp -R "$APP_SRC" "$APP_DST"
    chown -R root:wheel "$APP_DST"
fi

exit 0
