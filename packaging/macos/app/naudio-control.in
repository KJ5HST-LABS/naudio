#!/bin/sh
# Network Audio Service.app — the bundle executable (issue #96 item 4).
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Generated by CMake so the path is the one this build installs to. `exec` is deliberate: the
# daemon replaces this shell, so Activity Monitor and TCC see one process rather than a shell
# holding a child, and quitting from the control page ends the bundle too.
#
# Clicking twice is safe — control mode finds an already-running page on the configured port,
# opens it, and exits 0 rather than failing to bind. That is why this is three lines and not a
# launcher with its own idea of whether the daemon is up.
exec "@NAUDIO_SERVICE_EXEC@" --mode control --duration-ms 0 --open-page
