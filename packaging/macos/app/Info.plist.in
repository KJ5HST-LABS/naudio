<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  naudio Control.app (issue #96 item 4) - the Applications entry that opens the control page.
  SPDX-License-Identifier: LGPL-2.1-or-later

  A launcher, not a program: Contents/MacOS/naudio-control execs the installed daemon in control
  mode. It exists because the issue's acceptance is that an operator opens the page from an
  INSTALLED shortcut, and macOS has no equivalent of a .desktop file.

  LSUIElement is true so this does not take over the Dock and the menu bar as a foreground app
  would; it is a background program whose interface is a web page. NSMicrophoneUsageDescription
  is the string macOS shows when the daemon this bundle launches first opens a capture device -
  TCC attributes the request to the responsible process, which is this bundle, so the absence of
  this key is a prompt with no explanation in it.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>naudio Control</string>
    <key>CFBundleDisplayName</key>
    <string>naudio Control</string>
    <key>CFBundleIdentifier</key>
    <string>org.kj5hst.naudio.control</string>
    <key>CFBundleVersion</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundleShortVersionString</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>naudio-control</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>naudio streams the audio your radio's USB audio interface receives.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright (C) 2025-2026 Terrell Deppe. LGPL-2.1-or-later.</string>
</dict>
</plist>
